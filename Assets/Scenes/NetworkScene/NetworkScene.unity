--- !u!114 &999995783
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 999995780}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '

    <b><size=18>BINARY TOOL C COMPRESSION TESTS</size></b>

    ==================================================


    <b><color=#00FFFF>Float
    Compression Tests</color></b>

    <color=#00FF00>V</color> Float(1B): 50.000
    -> 50.196

    <color=#00FF00>V</color> Float(2B): 25.500 -> 25.499

    <color=#00FF00>V</color>
    Float(3B): 75.250 -> 75.250

    <color=#00FF00>V</color> Float(4B): 42.123 ->
    42.123

    <color=#00FF00>V</color> Float(2B): -10.000 -> -10.001

    <color=#00FF00>V</color>
    Float(1B): 0.000 -> 0.392

    <color=#00FF00>V</color> Float(2B): 100.000 ->
    99.998


    <b><color=#00FFFF>Vector2 Compression Tests</color></b>

    <color=#00FF00>V</color>
    Vector2(1,1B): (10.00, 20.00)

    <color=#00FF00>V</color> Vector2(2,2B): (50.50,
    75.25)

    <color=#00FF00>V</color> Vector2(3,3B): (33.33, 66.66)

    <color=#00FF00>V</color>
    Vector2(2,2B): (-25.00, 25.00)

    <color=#00FF00>V</color> Vector2(4,4B): (1.23,
    5.68)


    <b><color=#00FFFF>Vector3 Compression Tests</color></b>

    <color=#00FF00>V</color>
    Vector3(1,1,1B): (10.00, 20.00, 30.00)

    <color=#00FF00>V</color> Vector3(2,2,2B):
    (25.50, 50.50, 75.50)

    <color=#00FF00>V</color> Vector3(3,3,3B): (12.34,
    56.78, 90.12)

    <color=#00FF00>V</color> Vector3(2,2,2B): (-10.00, 0.00, 10.00)

    <color=#00FF00>V</color>
    Vector3(4,4,4B): (1.10, 2.20, 3.30)


    <b><color=#00FFFF>Vector4 Compression
    Tests</color></b>

    <color=#00FF00>V</color> Vector4(1,1,1,1B): (10.0, 20.0,
    30.0, 40.0)

    <color=#00FF00>V</color> Vector4(2,2,2,2B): (25.0, 50.0, 75.0,
    100.0)

    <color=#00FF00>V</color> Vector4(3,3,3,3B): (15.5, 35.5, 65.5, 85.5)

    <color=#00FF00>V</color>
    Vector4(2,2,2,2B): (-20.0, -10.0, 10.0, 20.0)

    <color=#00FF00>V</color> Vector4(4,4,4,4B):
    (1.1, 2.2, 3.3, 4.4)


    <b><color=#00FFFF>Edge Case Tests</color></b>

    <color=#00FF00>V</color>
    Float(1B): 0.000 -> 0.000

    <color=#00FF00>V</color> Float(1B): 1.000 -> 1.000

    <color=#00FF00>V</color>
    Vector2(1,1B): (0.00, 0.00)

    <color=#00FF00>V</color> Vector3(2,2,2B): (1.00,
